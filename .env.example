# ── Frontend (Vite) ──────────────────────────────────────────────
# Leave VITE_API_URL unset: the app calls /api on its own domain (a Vercel
# Function in production; in dev, vite.config.js proxies /api to the local
# server started with `npm run server`). Only variables prefixed with VITE_
# are exposed to the browser bundle.
# VITE_API_URL=

# ── Backend (server/index.js) ───────────────────────────────────
PORT=8787

# Copilot AI. Pick ONE provider (if both are set, Claude wins); with neither,
# the Copilot falls back to simple keyword answers.
#
# Free option — Groq (console.groq.com → API Keys). Defaults to the
# openai/gpt-oss-120b model; LLM_BASE_URL / LLM_MODEL let you point at any
# other OpenAI-compatible API.
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
#
# Paid option — Claude (console.anthropic.com → API Keys), Sonnet 5 by
# default (override with COPILOT_MODEL). Never expose keys in the frontend.
ANTHROPIC_API_KEY=

# ── Firebase (Auth + Firestore) ─────────────────────────────────
# From the Firebase console: Project settings → General → Your apps → SDK
# setup and configuration. Without these there is no login and no data
# (see src/services/firebase.js).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin credentials for the backend (server/services/firebaseAdmin.js).
# From the Firebase console: Project settings → Service accounts → Generate
# new private key. Copy the three fields below from the downloaded JSON.
# Required for: verifying the frontend's ID tokens and writing imported
# statements to Firestore.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal "\n" sequences from the JSON file — the app converts
# them back to real newlines at startup.
FIREBASE_PRIVATE_KEY=

# ── Open Finance (real bank connections, via Pluggy) ────────────
# NOVA never talks to Banco Central directly — that's only for regulated
# institutions. It goes through Pluggy (pluggy.ai), a certified Open
# Finance aggregator, using their official pluggy-sdk (backend) and
# react-pluggy-connect (frontend consent widget).
#   PLUGGY_CLIENT_ID / PLUGGY_CLIENT_SECRET → dashboard.pluggy.ai →
#     API keys (free sandbox available before going live)
#   PLUGGY_WEBHOOK_SECRET → any string you choose; register the webhook
#     URL (https://SEU_DOMINIO/api/open-finance/webhook) in the Pluggy
#     dashboard with a custom header "X-Webhook-Secret" set to this same
#     value (Pluggy doesn't sign webhooks, only supports custom headers)
# Leaving these unset keeps bank connections manual (the "Conectar banco
# automaticamente" button in Bancos simply doesn't show).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
