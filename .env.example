# ── Frontend (Vite) ──────────────────────────────────────────────
# Base URL of the NOVA API server (server/index.js). Only variables
# prefixed with VITE_ are exposed to the browser bundle.
VITE_API_URL=http://localhost:8787

# ── Backend (server/index.js) ───────────────────────────────────
PORT=8787
# Public URL of the frontend — used to build Stripe Checkout/Billing
# Portal success/cancel/return URLs.
APP_URL=http://localhost:5173

# Anthropic API key used by server/services/aiService.js to power the
# Copilot assistant. Never expose this in the frontend. If unset, the
# Copilot falls back to a local rule-based demo response on the client.
ANTHROPIC_API_KEY=

# ── Firebase (Auth + Firestore) ─────────────────────────────────
# From the Firebase console: Project settings → General → Your apps → SDK
# setup and configuration. Leaving these unset keeps the whole app in
# local/demo mode (localStorage instead of Firestore, no real accounts) —
# see src/services/firebase.js and the *Provider files under
# src/contexts/{authProviders,dataProviders}/.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin credentials for the backend (server/services/firebaseAdmin.js).
# From the Firebase console: Project settings → Service accounts → Generate
# new private key. Copy the three fields below from the downloaded JSON.
# Required for: verifying the frontend's ID tokens, and for the Stripe
# webhook to write subscription state to Firestore.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal "\n" sequences from the JSON file — the app converts
# them back to real newlines at startup.
FIREBASE_PRIVATE_KEY=

# ── Stripe (NOVA Pro subscription) ──────────────────────────────
# From the Stripe dashboard (test mode while developing):
#   STRIPE_SECRET_KEY   → Developers → API keys → Secret key
#   STRIPE_PRICE_ID     → Product catalog → your R$14,90/mês recurring
#                         Price id (price_...). Run
#                         `node scripts/create-stripe-price.js` to create
#                         it automatically once STRIPE_SECRET_KEY is set.
#   STRIPE_WEBHOOK_SECRET → Developers → Webhooks → your endpoint's
#                         signing secret (whsec_...), or the value printed
#                         by `stripe listen --forward-to localhost:8787/api/stripe/webhook`
# Leaving these unset keeps subscribing to NOVA Pro in demo mode
# (server/services/paymentService.js), clearly labeled in the UI.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Open Finance (real bank connections, via Pluggy) ────────────
# NOVA never talks to Banco Central directly — that's only for regulated
# institutions. It goes through Pluggy (pluggy.ai), a certified Open
# Finance aggregator, using their official pluggy-sdk (backend) and
# react-pluggy-connect (frontend consent widget).
#   PLUGGY_CLIENT_ID / PLUGGY_CLIENT_SECRET → dashboard.pluggy.ai →
#     API keys (free sandbox available before going live)
#   PLUGGY_WEBHOOK_SECRET → any string you choose; register the webhook
#     URL (https://SEU_DOMINIO/api/open-finance/webhook) in the Pluggy
#     dashboard with a custom header "X-Webhook-Secret" set to this same
#     value (Pluggy doesn't sign webhooks, only supports custom headers)
# Leaving these unset keeps bank connections manual on the client (the
# "Conectar banco automaticamente" button in Bancos simply doesn't show).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
