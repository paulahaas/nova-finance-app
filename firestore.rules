rules_version = '2';

// NOVA is a single-user app: every document lives under users/{uid}/... and
// only the owner's UID (same value as src/config/owner.js) can touch them.
// Even if someone creates a Firebase Auth account through the API, these
// rules give them access to nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == 'cBGW1AYLG8X1eGD1mBAdWILUnnI2';
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
